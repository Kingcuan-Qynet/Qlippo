# ── SUPABASE (this project's OWN Supabase project — separate from QYNET) ───
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── APP ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Qlippo"

# ── STORAGE (Cloudflare R2 — photos/videos, avatars, covers) ─────────────
# 1. Create a Cloudflare account → R2 → Create bucket (any name).
# 2. R2 → Manage API Tokens → Create API Token (permissions: Object Read & Write,
#    scoped to this bucket). Copy the Account ID, Access Key ID, and Secret.
# 3. For NEXT_PUBLIC_R2_PUBLIC_URL: either connect a custom domain to the
#    bucket (Settings → Public Access → Connect Domain — recommended for
#    production), or for local testing only, enable the bucket's r2.dev URL
#    and use that (Cloudflare explicitly says r2.dev is not for production —
#    it's rate-limited).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=qlippo-media
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.yourdomain.com

# ── VIDEO CALL (WebRTC) ──────────────────────────────────────────────────
# Public STUN servers are free and sufficient for most 1:1 calls. If calls
# fail to connect for users behind strict/symmetric NATs, add a TURN
# server later (e.g. Cloudflare Calls, Twilio, or metered.ca's free tier)
# and list it here — the calling code already reads this array.
NEXT_PUBLIC_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ── FUTURE / NOT NEEDED FOR MVP — kept here so the "slots" are visible ───
# Uncomment and wire in only once real traffic justifies the complexity.
# REDIS_URL=
# QUEUE_URL=
# MEILISEARCH_URL=
# MEILISEARCH_API_KEY=
